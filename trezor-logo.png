\"4909\",\"static/chunks/4909-14ff90e4518aa9af.js\",\"8487\",\"static/chunks/8487-f59e21fe6899c90f.js\",\"4202\",\"static/chunks/4202-714964a28b5cc49c.js\",\"5279\",\"static/chunks/5279-a3e7dd3c8297992a.js\",\"3960\",\"static/chunks/3960-d83f192d5200e232.js\",\"9391\",\"static/chunks/9391-0a23723201b977c8.js\",\"9255\",\"static/chunks/9255-421877e6f388b734.js\",\"2616\",\"static/chunks/app/%5Blang%5D/(pages)/layout-a3a30705f4df90c3.js\"],\"Footer\"]\n2a:I[16747,[\"4909\",\"static/chunks/4909-14ff90e4518aa9af.js\",\"8487\",\"static/chunks/8487-f59e21fe6899c90f.js\",\"4202\",\"static/chunks/4202-714964a28b5cc49c.js\",\"5279\",\"static/chunks/5279-a3e7dd3c8297992a.js\",\"3960\",\"static/chunks/3960-d83f192d5200e232.js\",\"9391\",\"static/chunks/9391-0a23723201b977c8.js\",\"9255\",\"static/chunks/9255-421877e6f388b734.js\",\"2616\",\"static/chunks/app/%5Blang%5D/(pages)/layout-a3a30705f4df90c3.js\"],\"Con"])</script><script>self.__next_f.push([1,"tainer\"]\n2b:I[64152,[\"4909\",\"static/chunks/4909-14ff90e4518aa9af.js\",\"8487\",\"static/chunks/8487-f59e21fe6899c90f.js\",\"4202\",\"static/chunks/4202-714964a28b5cc49c.js\",\"5279\",\"static/chunks/5279-a3e7dd3c8297992a.js\",\"3960\",\"static/chunks/3960-d83f192d5200e232.js\",\"9391\",\"static/chunks/9391-0a23723201b977c8.js\",\"9255\",\"static/chunks/9255-421877e6f388b734.js\",\"2616\",\"static/chunks/app/%5Blang%5D/(pages)/layout-a3a30705f4df90c3.js\"],\"RelayProvider\"]\n2c:I[80622,[],\"IconMark\"]\n:HL[\"/_next/static/css/f89d848d6a85bc4a.css\",\"style\"]\n:HL[\"/_next/static/media/68ed26f9d69f132e-s.p.woff2\",\"font\",{\"crossOrigin\":\"\",\"type\":\"font/woff2\"}]\n:HL[\"/_next/static/media/ad67f640d4bb0eae-s.p.woff2\",\"font\",{\"crossOrigin\":\"\",\"type\":\"font/woff2\"}]\n:HL[\"/_next/static/media/eaa0d296b10c69c0-s.p.woff2\",\"font\",{\"crossOrigin\":\"\",\"type\":\"font/woff2\"}]\n:HL[\"/_next/static/css/0a78e4e0e495382b.css\",\"style\"]\n3:T5d4,"])</script><script>self.__next_f.push([1,"All orders are usually processed and handed over to the delivery provider within 1 day. However, estimated delivery times can vary from country to country.\u003c0\u003eUnited States\u003c/0\u003e\u003c1\u003eStandard\u003c/1\u003eDelivery takes place within 3 to 5 business days after the order is processed and the package has been dispatched. Packages are fully trackable.\u003c2/\u003e\u003c3\u003eUnited Kingdom\u003c/3\u003e\u003c4\u003eStandard\u003c/4\u003e\u003c5\u003eDelivery takes place within 3 to 5 business days after the order is processed and the package has been dispatched. Packages are fully trackable and can be traced \u003c6\u003ehere\u003c/6\u003e.\u003c/5\u003eAll UK orders are shipped from our UK warehouse, to ensure a fast hassle free delivery for our UK customers.\u003c7\u003eInternationally\u003c/7\u003e\u003c8\u003eEconomy\u003c/8\u003e\u003c9\u003eOutside the United States and United Kingdom, Economy shipping is only available in EU and several non-EU countries. Tracking information can sometimes prove limited.\u003c/9\u003e\u003c10\u003eDelivery time may vary between two days to six weeks depending on your location and your national post service.\u003c/10\u003e\u003c11\u003eA parcel sent via Economy shipping can be traced \u003c12\u003ehere\u003c/12\u003e until it leaves the country of origin. After that, it can be traced on the website of the postal service in your country, if available.\u003c/11\u003e\u003c13\u003eStandard (expedited) shipping\u003c/13\u003e\u003c14\u003eStandard shipping usually takes 2 to 7 business days (up to 14 days for island addresses) after the order has shipped.\u003c/14\u003e\u003c15\u003eOrder tracking is added to each shipment.\u003c/15\u003e\u003c16\u003eParcels ordered using Standard shipping can be tracked \u003c17\u003ehere\u003c/17\u003e.\u003c/16\u003e"])</script><script>self.__next_f.push([1,"4:T467,"])</script><script>self.__next_f.push([1,"\u003c0\u003eThere have been slight modifications to the packaging over the years and it could be that your package is an older design. You can check the \u003c1\u003epackaging timeline of Trezor Model T\u003c/1\u003e and \u003c2\u003eTrezor Model One\u003c/2\u003e.\u003c/0\u003eIn addition to checking the integrity of the packaging there are extra security measures in place to help verify the security of your Trezor device:\u003c3\u003e\u003c4\u003e\u003c5\u003eAll Trezor devices are distributed without firmware installed\u003c/5\u003e - It will be installed during the initial setup. The setup process will check if firmware has already been installed on the device. If firmware is detected then the device should not be used.\u003c/4\u003e\u003c6\u003eThe bootloader verifies the firmware signature each time you connect your Trezor to a computer. \u003c7\u003eTrezor Suite will only accept the device if the installed firmware is correctly signed by SatoshiLabs\u003c/7\u003e. If unofficial firmware has been installed, your device will flash a warning sign on its screen upon being connected to a computer.\u003c/6\u003e\u003c8\u003eYou will need to generate a recovery seed during Trezor setup. This seed is unique, ensuring only you have access to your private keys.\u003c/8\u003e\u003c/3\u003e"])</script><script>self.__next_f.push([1,"5:T509,"])</script><script>self.__next_f.push([1,"\u003c0\u003eWe never postpone shipping without notifying you first. If there is a delay before the package has been dispatched, it may be due to incomplete shipping information being provided. In that case, our Customer Support team will contact you and request the missing information.\u003c/0\u003e\u003c1\u003eInternational deliveries will be processed by customs on arrival. This is where most delays occur. The delivery will only appear in a customer's local post tracking system once it has been released by customs. This process can sometimes delay items by many weeks.\u003c/1\u003e\u003c2\u003eIn rare cases, using standard shipping, your package may get lost during transport. These are processed as a \u003c3\u003elost package\u003c/3\u003e and dealt with through an \u003c4\u003einvestigation process\u003c/4\u003e. \u003c5\u003eContact\u003c/5\u003e \u003c6\u003eTrezor support\u003c/6\u003e via our \u003c7\u003echatbot Hal.\u003c/7\u003e if you believe your package has been lost.\u003c/2\u003eAn investigation into a lost package can be initiated if your order meets at least one of the following criteria:\u003c8\u003e\u003c9\u003ethe package does not leave country of origin within ten days\u003c/9\u003e\u003c10\u003ethe package does not appear on the destination country's tracking service within 21 days\u003c/10\u003e\u003c11\u003eno update in status for 21 days\u003c/11\u003e\u003c/8\u003ePlease contact \u003c12\u003eTrezor support\u003c/12\u003e via our \u003c13\u003echatbot Hal\u003c/13\u003e if you believe that your package has been lost."])</script><script>self.__next_f.push([1,"6:T47a,"])</script><script>self.__next_f.push([1,"Available shipping methods vary by country. Make sure you select the correct destination country during checkout.\u003c0\u003eEconomy shipping\u003c/0\u003e\u003c1\u003eEconomy shipping is available in EU and several non-EU countries. Package tracking is limited.\u003c/1\u003e\u003c2\u003eDelivery time may take from two days to six weeks, depending on your location and national post service.\u003c/2\u003eParcels ordered using Economy shipping can be tracked \u003c3\u003ehere\u003c/3\u003e until it leaves the country of origin. It can then be tracked using your country's postal service website if available.\u003c4\u003eStandard (expedited) shipping\u003c/4\u003e\u003c5\u003eStandard shipping usually takes 2 to 7 business days (up to 14 days for island addresses) after the order has shipped.\u003c/5\u003e\u003c6\u003eOrder tracking is added to each shipment.\u003c/6\u003eParcels ordered using Standard shipping can be tracked \u003c7\u003ehere\u003c/7\u003e.\u003c8\u003eDelivery in the UK and USA\u003c/8\u003eOrders delivered to customers in the United Kingdom and the United States of America are dispatched by local fulfillment centers using local delivery services.\u003c9\u003e\u003c10\u003eThe US orders are shipped from Chattanooga (TN), Grapevine (TX), Phoenix (AZ).\u003c/10\u003e\u003c11\u003eThe UK orders are shipped from Manchester.\u003c/11\u003e\u003c/9\u003e"])</script><script>self.__next_f.push([1,"7:T437,"])</script><script>self.__next_f.push([1,"\u003c0\u003eIf you are having trouble completing your payment or your purchase has been declined, there might be an issue with your bank or credit card. There are a few steps you can take to try and remedy the situation.\u003c/0\u003eThe cookies stored by your browser might be one of the issues. You can try one of the following workarounds:\u003c1\u003e\u003c2\u003eClearing the cache of your browser\u003c/2\u003e\u003c3\u003eTry using an incognito window to pay for the order\u003c/3\u003e\u003c4\u003eTry using a different browser.\u003c/4\u003e\u003c/1\u003e\u003c5/\u003e\u003c6\u003eIf that does not work it may be that your card is being declined due to the fact that your card is not able to process transactions without first informing your bank or credit card company. If your card continues to be declined please reach out to your bank to determine if this could be the issue or if there is something else that is causing your payment to fail.\u003c/6\u003eAlternatively you can purchase your order by cryptocurrency. You can pay with Bitcoin, Bitcoin Lightning, Ethereum or Litecoin via Confirmo. You can also try to use one of our \u003c7\u003eofficial resellers\u003c/7\u003e or our official \u003c8\u003eAmazon Store\u003c/8\u003e."])</script><script>self.__next_f.push([1,"8:T7dc,"])</script><script>self.__next_f.push([1,"\u003c0\u003eIt is possible to pay using Bitcoin, Bitcoin Lightning, Ethereum or Litecoin.\u003c/0\u003eIf you completed and paid for your order with cryptocurrency and it was canceled, one of the following may have occurred:\u003c1\u003eInsufficient amount\u003c/1\u003eThe service or wallet you used to send the payment has deducted fees from the final amount, so the full price has not been paid. This can happen when paying from an exchange. Contact \u003c2\u003eTrezor support\u003c/2\u003e via our \u003c3\u003echatbot Hal\u003c/3\u003e to request a refund.\u003c4\u003eOverpaid amount\u003c/4\u003eIf your order was overpaid, please contact \u003c5\u003eTrezor support\u003c/5\u003e via our \u003c6\u003echatbot Hal.\u003c/6\u003e\u003c7\u003ePaid after timeout\u003c/7\u003eCurrently, our system accepts payments received within 15 minutes of requesting the payment. If the transaction arrives after the 15 minute window, you should contact \u003c8\u003eTrezor support\u003c/8\u003e via our \u003c9\u003echatbot Hal\u003c/9\u003e. and request a refund.\u003c10\u003eUnconfirmed transaction\u003c/10\u003e\u003c11\u003eSetting a low transaction fee for crypto transactions might take longer for the transaction to confirm and may not be received in time. If your payment does not confirm, increase the fee or place a new order.\u003c/11\u003e\u003c12\u003eWhen paying for your order with crypto you can create a temporary wallet online and transfer your Bitcoin funds from an exchange to your wallet. Once you've done that, you should be able to process the payment from your wallet instantaneously, without risking an underpaid or outdated payment.\u003c/12\u003e\u003c13\u003eOnce you complete a payment on Confirmo payment gateway, bookmark the page, as you can use it later to check on your payment status.\u003c/13\u003eIf you have your Confirmo crypto payment URL you can apply for a refund yourself using the same link that you used to pay. ****The URL starts with \u003c14\u003ehttps://confirmo.net/public/invoice\u003c/14\u003e and once clicked on Request refund button, you will need to fill in your preferred address where you would like the refund sent. If you do not have that payment URL please reach out to \u003c15\u003eTrezor support\u003c/15\u003e via our \u003c16\u003echatbot Hal\u003c/16\u003e. so we can assist you further."])</script><script>self.__next_f.push([1,"9:T42a,"])</script><script>self.__next_f.push([1,"\u003c0\u003eTrezor emerged from the chaos of online exchanges that just couldn't keep up. We realized it was time to step up the security game against online attacks and malicious apps.\u003c/0\u003e\u003c1\u003eOur founders, Stick and Slush, teamed up to create, advance, and revolutionize an entirely new industry, bringing about a complete about-face from traditional, online crypto storage and management.\u003c/1\u003e\u003c2\u003eWith an independent and open-minded approach to development, Stick and Slush transformed their humble beginnings into an industry leader with a solid team of security experts, designers, and support staff. The final result is Trezor today, further pushing the envelope of crypto security, hardware wallet innovation, and global Bitcoin adoption.\u003c/2\u003e\u003c3\u003eWith Trezor in your corner, you have a true haven to stash and use your coins exactly the way you want. Our sister companies stand united, providing peer-to-peer crypto transactions, auditable open-source chip solutions, and exceptional crypto offers.\u003c/3\u003e\u003c4\u003eReady to be the boss of your financial future? Welcome to Trezor.\u003c/4\u003e"])</script><script>self.__next_f.push([1,"a:T42a,"])</script><script>self.__next_f.push([1,"\u003c0\u003eTrezor emerged from the chaos of online exchanges that just couldn't keep up. We realized it was time to step up the security game against online attacks and malicious apps.\u003c/0\u003e\u003c1\u003eOur founders, Stick and Slush, teamed up to create, advance, and revolutionize an entirely new industry, bringing about a complete about-face from traditional, online crypto storage and management.\u003c/1\u003e\u003c2\u003eWith an independent and open-minded approach to development, Stick and Slush transformed their humble beginnings to an industry leader with a solid team of security experts, designers, and support staff. The final result is Trezor today, further pushing the envelope of crypto security, hardware wallet innovation, and global bitcoin adoption.\u003c/2\u003e\u003c3\u003eWith Trezor in your corner, you a have a true haven to stash and use your coins exactly the way you want. Our sister companies stand united, providing peer-to-peer crypto transactions, auditable open-source chip solutions, and exceptional crypto offers.\u003c/3\u003e\u003c4\u003eReady to be the boss of your financial future? Welcome to Trezor.\u003c/4\u003e"])</script><script>self.__next_f.push([1,"0:{\"P\":null,\"b\":\"u5jUJnopydQBxQ_YtMPM3\",\"p\":\"\",\"c\":[\"\",\"images\",\"trezor-logo-white.svg\"],\"i\":false,\"f\":[[[\"\",{\"children\":[[\"lang\",\"images\",\"d\"],{\"children\":[\"(pages)\",{\"children\":[[\"all\",\"trezor-logo-white.svg\",\"c\"],{\"children\":[\"__PAGE__\",{}]}]}]}]},\"$undefined\",\"$undefined\",true],[\"\",[\"$\",\"$1\",\"c\",{\"children\":[[[\"$\",\"link\",\"0\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/css/f89d848d6a85bc4a.css\",\"precedence\":\"next\",\"crossOrigin\":\"$undefined\",\"nonce\":\"$undefined\"}]],[\"$\",\"$L2\",null,{\"initialLocale\":\"en\",\"initialMessages\":{\"+/b5ae\":[\"Wireless charging\"],\"+0AlDv\":[\"Supports 1000s \u003c0/\u003e of coins \u0026 tokens\"],\"+3VZcr\":[\"Securely lock in your tokens, back the blockchain, and earn rewards in return. Sit back, kick your feet up, and watch your token balance grow with Trezor.\"],\"+5eC6Y\":[\"LiFePO₄ battery\"],\"+6wK5q\":[\"Company page hero\"],\"+7JxW6\":[\"Learn about upcoming releases, try out cool tips, and stay up to date with everything Trezor.\"],\"+7wmjX\":[\"I agree to the \u003c0\u003eTerms of Service\u003c/0\u003e.\"],\"+8UPpA\":[\"The cookies stored by your browser might be one of the issues. You can try one of the following workarounds:\"],\"+9+RG